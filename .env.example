# Copy to .env (local) or set in your host's secret manager (production). Never commit .env.

APP_NAME=PesaFlow
PUBLIC_URL=http://localhost:3000            # production: https://app.yourdomain.co.ke
DATABASE_URL=postgres://pesaflow:pesaflow_dev_only@localhost:5433/pesaflow
DB_POOL_MAX=10
TRIAL_DAYS=14
SESSION_DAYS=30
ADMIN_EMAILS=                               # comma separated; can open /api/admin/stats

# M-Pesa (Kenya) prices, whole KES
PLAN_MONTHLY_KES=299
PLAN_QUARTERLY_KES=799
PLAN_YEARLY_KES=2999
# Display prices for everyone else (landing page + plan picker). What customers actually pay,
# in their currency and including tax, is set on the Paddle prices (use country price overrides for PPP).
PLAN_MONTHLY_USD=3
PLAN_QUARTERLY_USD=8
PLAN_YEARLY_USD=29

# Background jobs: 1 = run inline in the web process (local dev); 0 = queue for `npm run worker` (production)
JOBS_INLINE=1

# ---- M-Pesa (Daraja) — https://developer.safaricom.co.ke
MPESA_ENV=mock                              # mock (no money) | sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379                      # sandbox paybill; your paybill / store number in production
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline # CustomerBuyGoodsOnline for a till
MPESA_PARTY_B=                              # till number for Buy Goods; defaults to shortcode
MPESA_CALLBACK_SECRET=                      # required outside mock: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ---- Cards, PayPal & local methods worldwide: Paddle (merchant of record) — https://vendors.paddle.com
PADDLE_ENV=mock                             # mock (no money) | sandbox | production
PADDLE_CLIENT_TOKEN=                        # Developer tools > Authentication > client-side token (test_… / live_…)
PADDLE_API_KEY=                             # server API key; used to cancel subscriptions when a user deletes their account
PADDLE_WEBHOOK_SECRET=                      # Notifications > your destination's secret key
PADDLE_PRICE_MONTHLY=                       # pri_… recurring monthly price
PADDLE_PRICE_QUARTERLY=                     # pri_… recurring every-3-months price
PADDLE_PRICE_YEARLY=                        # pri_… recurring yearly price

# ---- Messages
NOTIFY_ENV=mock                             # mock = printed to the log | live = really sent
RESET_CODE_MINUTES=15
RESET_MAX_ATTEMPTS=5
RENEWAL_REMINDER_DAYS=3
# ZeptoMail (Zoho) — Mail Agent > SMTP/API > Send Mail Token
ZEPTOMAIL_TOKEN=                            # "Zoho-enczapikey ..." (prefix optional)
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
MAIL_FROM_ADDRESS=no-reply@yourdomain.co.ke # must be on a domain verified in ZeptoMail
MAIL_FROM_NAME=PesaFlow
# Africa's Talking SMS (AT_USERNAME=sandbox for testing)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SMS_COUNTRIES=KE,UG,TZ,RW,MW,NG,ZM,ET,CI,CM,SN,GH,ZA   # SMS only to these; email everywhere

# ---- Cloudflare Turnstile (optional bot check on sign-up / reset)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
