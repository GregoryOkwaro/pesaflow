# Copy to .env and fill in. Never commit .env.

APP_NAME=PesaFlow
PUBLIC_URL=https://app.example.co.ke        # must be https in production (cookies + Daraja callback)
DATABASE_PATH=./data/cashflow.db
TRIAL_DAYS=14
SESSION_DAYS=30
ADMIN_EMAILS=you@yourcompany.com            # comma separated; get /api/admin/stats

# Prices in whole KES
PLAN_MONTHLY_KES=299
PLAN_QUARTERLY_KES=799
PLAN_YEARLY_KES=2999

# M-Pesa Daraja — https://developer.safaricom.co.ke
# mock = local testing, no network | sandbox = Safaricom test env | production = real money
MPESA_ENV=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379                      # sandbox paybill; replace with your paybill / store number
MPESA_PASSKEY=                              # Lipa Na M-Pesa Online passkey from Safaricom
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline # or CustomerBuyGoodsOnline for a till
MPESA_PARTY_B=                              # till number if using Buy Goods; defaults to shortcode
MPESA_CALLBACK_SECRET=                      # long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))"

# Password reset codes. mock = printed to the server log (local dev ONLY) | live = really sent
NOTIFY_ENV=mock
RESET_CODE_MINUTES=15
RESET_MAX_ATTEMPTS=5
# Email (any SMTP provider: Gmail/Workspace app password, Zoho, Brevo, Amazon SES…)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls                      # starttls | ssl (usually port 465) | none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PesaFlow <no-reply@example.co.ke>
# SMS via Africa's Talking (sent too when the user saved a phone number). AT_USERNAME=sandbox for testing.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=                               # optional approved sender ID
