# Worker image: runs database migrations on start, then processes background jobs
# (messages, payment reconciliation, renewal reminders, exchange rates).
#   docker build -f Dockerfile.worker -t pesaflow-worker .

FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production
RUN useradd --system --uid 1001 pesaflow
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY --chown=pesaflow tsconfig.json ./
COPY --chown=pesaflow drizzle ./drizzle
COPY --chown=pesaflow src ./src
USER pesaflow
CMD ["sh", "-c", "npx tsx src/server/db/migrate.ts && npx tsx src/server/jobs/worker.ts"]
